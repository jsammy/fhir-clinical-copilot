# Copy to .env (gitignored) and fill in. Never commit .env.
COPILOT_LLM=bedrock
# Bedrock API key: Bedrock console -> API keys. Short-term keys expire within 12 hours.
AWS_BEARER_TOKEN_BEDROCK=
# The region the key was generated in, e.g. ap-south-1
AWS_REGION=
# Inference profile id from the Bedrock model catalog
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Notes search embeddings: hash (offline, free, keyword-like) or bedrock (Titan V2, semantic).
# After changing it, rebuild: python -m src.retrieval.notes_index build
NOTES_EMBEDDER=hash
